# Optional privacy-friendly Umami Cloud analytics.
# Create a free website in Umami Cloud and copy its website ID here.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Keep SQLite on durable storage in production.
DATABASE_PATH=./data/rolegrove.sqlite

# Set these in Vercel for the hosted deployment. Never expose the service key
# to the browser or commit it to Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
